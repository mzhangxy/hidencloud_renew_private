name: HidenCloud Auto Renew

on:
  workflow_dispatch:
  #schedule:
  #  - cron: '15 2 * * *'

jobs:
  renew:
    runs-on: ubuntu-latest
    steps:
      - name: 📥 检出代码
        uses: actions/checkout@v4

      - name: 🐍 配置 Python 环境
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: 📦 安装核心环境与依赖
        run: |
          # ⭐️ 安装 Xvfb 虚拟屏幕组件
          sudo apt-get update
          sudo apt-get install -y xvfb xdotool
          
          python -m pip install --upgrade pip
          pip install DrissionPage pynacl requests

      - name: ⚙️ 部署并配置 Xray 核心
        run: |
          wget -q https://github.com/XTLS/Xray-core/releases/latest/download/Xray-linux-64.zip
          unzip -q Xray-linux-64.zip -d xray_core
          chmod +x xray_core/xray
          
          cat << 'EOF' > xray_core/config.json
          ${{ secrets.XRAY_CONFIG_JSON }}
          EOF

      - name: 🚀 启动 Xray 代理隧道
        run: |
          nohup ./xray_core/xray -c ./xray_core/config.json > xray.log 2>&1 &
          sleep 5
          curl -x socks5h://127.0.0.1:10808 https://api.ipify.org
          echo ""

      - name: 🤖 在虚拟屏幕中执行续期脚本
        env:
          TG_BOT_TOKEN: ${{ secrets.TG_BOT_TOKEN }}
          TG_CHAT_ID: ${{ secrets.TG_CHAT_ID }}
          GH_TOKEN: ${{ secrets.GH_TOKEN }}
          ACCOUNTS: ${{ secrets.ACCOUNTS }}
          PROXY: 'socks5://127.0.0.1:10808'
        run: |
          # ⭐️ 使用 xvfb-run 创建一个 1920x1080 的虚拟显示屏，并在其中运行 Python
          xvfb-run --auto-servernum --server-args="-screen 0 1920x1080x24" python scripts/hidencloud_renew.py

      - name: 📤 收集错误截图
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: debug-screenshots
          path: ./*.png
          retention-days: 3
